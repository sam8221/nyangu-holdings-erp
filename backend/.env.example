# Copy to .env and fill in. Never commit .env.

APP_NAME=Nyangu Holdings ERP
# development | testing | staging | production
ENVIRONMENT=development
# Must be false outside development
DEBUG=false
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text

# postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/nyangu_erp
# Disposable database for pytest. It is wiped before every test. Never point it at nyangu_erp.
TEST_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/nyangu_erp_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=5

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Base URL used in emailed links (password reset)
FRONTEND_URL=http://localhost:5173
MAX_REQUEST_BODY_BYTES=2097152
DOCS_ENABLED=true

# Email: file (writes .eml files to EMAIL_FILE_DIR), smtp, or console
EMAIL_BACKEND=file
EMAIL_FROM=Nyangu Holdings ERP <no-reply@nyanguholdings.com>
EMAIL_FILE_DIR=var/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

DEFAULT_CURRENCY=ZMW
TIMEZONE=Africa/Lusaka

# First administrator, created by: python -m app.seed.run
SEED_ADMIN_EMAIL=admin@nyanguholdings.com
# Leave empty to be prompted for it
SEED_ADMIN_PASSWORD=
